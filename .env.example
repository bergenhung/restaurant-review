# Copy to .env for local runs. Never commit .env.
GOOGLE_PLACES_API_KEY=
# Optional: a separate key for the results map, restricted to Maps JavaScript API + your site.
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAP_ID=DEMO_MAP_ID
# Optional. Tripadvisor (Terra API): one-time free allowance, then billed per item.
TRIPADVISOR_API_KEY=
# Billable items per UTC day before Tripadvisor is skipped until midnight. 0 = no cap.
TRIPADVISOR_DAILY_ENTITY_LIMIT=30
# "us,tw" (default), "us" or "tw"
TRIPADVISOR_MARKETS=us,tw
# Markets where a name miss is retried with a nearby search (costs up to 3 more items)
TRIPADVISOR_FALLBACK_MARKETS=tw
# Optional, paid. Without it, US rows get a free "See on Yelp" link instead.
YELP_API_KEY=
MICHELIN_US_CSV_PATH=data/michelin_us.csv
MICHELIN_TW_CSV_PATH=data/michelin_tw.csv
# memory (local) or firestore (GCP)
STORE=memory
GCP_PROJECT=
CACHE_TTL_HOURS=6
# Optional. If set, callers must send X-API-Key with this value.
SERVICE_API_KEY=
LOG_LEVEL=INFO
